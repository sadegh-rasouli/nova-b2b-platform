{
  "name": "nova-b2b-platform",
  "version": "1.0.0",
  "description": "NOVA — Enterprise B2B Industrial Materials & Polymer Platform",
  "author": "Mohammad Sadegh Rasouli",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build:client": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "start:server": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
