# ==========================================
# NOVA B2B Platform - Environment Variables Template
# ==========================================
# Copy this file to .env and provide your secure local/production values.
# NEVER commit the actual .env file to version control.

# --- Backend Server Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- MongoDB Database Connection ---
MONGODB_URI=

# --- Security & JWT Authentication ---
# In production, generate a secure random secret (e.g. openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Initial Seed Admin Configuration ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api
